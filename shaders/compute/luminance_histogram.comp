#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D srcTexture;
layout(set = 0, binding = 1, std430) buffer HistogramBuffer {
    uint histogram[];
};
layout(set = 0, binding = 2) uniform sampler2D depthTexture;

layout(push_constant) uniform Push {
    float minLogLum;
    float logLumRange;
    float timeDelta;
    float sampleStride; // 1 = todo pixel; N = um a cada NxN (GPU fraca)
    vec4 rowY;  // linha y da invViewProj
    vec4 rowW;  // linha w
    vec4 cam;   // x = altura da camera, y = 1 tira o fundo abaixo do horizonte
} push;

shared uint localHistogram[256];

float luminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    uint lid = gl_LocalInvocationIndex;
    if (lid < 256u) {
        localHistogram[lid] = 0u;
    }
    barrier();

    ivec2 texSize = textureSize(srcTexture, 0);
    uint stride = max(uint(push.sampleStride), 1u);
    uvec2 texel = gl_GlobalInvocationID.xy * stride;
    vec2 uv = (vec2(texel) + 0.5 * float(stride)) / vec2(texSize);

    if (texel.x < uint(texSize.x) && texel.y < uint(texSize.y)) {
        vec3 color = texture(srcTexture, uv).rgb;
        float lum = luminance(color);
        float logLum = clamp((log2(lum + 1e-5) - push.minLogLum) / push.logLumRange, 0.0, 1.0);
        uint bin = uint(logLum * 255.0);
        // Fundo abaixo do horizonte (sem geometria, raio descendo): o vao da
        // borda do mundo nao e' cena e nao mexe na exposicao.
        bool fundo = false;
        if (push.cam.y > 0.5 && textureLod(depthTexture, uv, 0.0).r >= 0.99999) {
            vec4 clip = vec4(uv * 2.0 - 1.0, 1.0, 1.0);
            fundo = dot(push.rowY, clip) / dot(push.rowW, clip) < push.cam.x;
        }
        if (!fundo) atomicAdd(localHistogram[bin], 1u);
    }
    
    barrier();
    
    if (lid < 256u) {
        uint localVal = localHistogram[lid];
        if (localVal > 0u) {
            atomicAdd(histogram[lid], localVal);
        }
    }
}
