#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint srcMipLevel;   // nível fonte (N)
    uint dstMipLevel;   // nível destino (N+1)
    uint srcWidth;
    uint srcHeight;
    uint gammaCorrect;  // 1 = sRGB, 0 = linear (para normal maps, etc.)
    uint alphaMode;     // 0 = simple average, 1 = alpha-weighted, 2 = coverage preserve
} pc;

layout(set = 0, binding = 0) uniform sampler2D srcTexture;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dstImage;

const float GAMMA = 2.2;
const float INV_GAMMA = 1.0 / 2.2;

vec3 toLinear(vec3 c) { return pow(c, vec3(GAMMA)); }
vec3 toSRGB(vec3 c)   { return pow(c, vec3(INV_GAMMA)); }

// Legacy chroma-key: pure magenta = transparent
void applyMagentaAlpha(inout vec4 col) {
    const vec3 magenta = vec3(1.0, 0.0, 1.0);
    float eps = 0.01;
    if (all(lessThan(abs(col.rgb - magenta), vec3(eps)))) {
        col.a = 0.0;
    }
}

// Leitura exata dos 4 texels fonte (sem interpolação do sampler)
// Clamp simula CLAMP_TO_EDGE para dimensões ímpares ou 1xN
void fetch4(ivec2 srcCoord, int mip, ivec2 srcSize,
            out vec4 s00, out vec4 s10, out vec4 s01, out vec4 s11) {
    ivec2 c00 = min(srcCoord + ivec2(0, 0), srcSize - 1);
    ivec2 c10 = min(srcCoord + ivec2(1, 0), srcSize - 1);
    ivec2 c01 = min(srcCoord + ivec2(0, 1), srcSize - 1);
    ivec2 c11 = min(srcCoord + ivec2(1, 1), srcSize - 1);

    s00 = texelFetch(srcTexture, c00, mip);
    s10 = texelFetch(srcTexture, c10, mip);
    s01 = texelFetch(srcTexture, c01, mip);
    s11 = texelFetch(srcTexture, c11, mip);

    applyMagentaAlpha(s00);
    applyMagentaAlpha(s10);
    applyMagentaAlpha(s01);
    applyMagentaAlpha(s11);
}

vec4 downsampleAlphaWeighted(ivec2 srcCoord, int mip, ivec2 srcSize) {
    vec4 s00, s10, s01, s11;
    fetch4(srcCoord, mip, srcSize, s00, s10, s01, s11);

    float aSum = s00.a + s10.a + s01.a + s11.a;
    vec3 color = vec3(0.0);
    if (aSum > 0.001) {
        color = (s00.rgb * s00.a + s10.rgb * s10.a + s01.rgb * s01.a + s11.rgb * s11.a) / aSum;
    }
    float alpha = aSum * 0.25;

    return vec4(color, alpha);
}

vec4 downsampleCoveragePreserve(ivec2 srcCoord, int mip, ivec2 srcSize) {
    vec4 s[4];
    fetch4(srcCoord, mip, srcSize, s[0], s[1], s[2], s[3]);

    float coverage = 0.0;
    for (int i = 0; i < 4; i++) coverage += (s[i].a > 0.5) ? 0.25 : 0.0;

    float aSum = 0.0;
    vec3 color = vec3(0.0);
    for (int i = 0; i < 4; i++) {
        color += s[i].rgb * s[i].a;
        aSum += s[i].a;
    }
    if (aSum > 0.001) color /= aSum;

    float alpha = (coverage > 0.0) ? max(coverage, aSum * 0.25) : 0.0;

    return vec4(color, alpha);
}

vec4 downsampleSimple(ivec2 srcCoord, int mip, ivec2 srcSize) {
    vec4 s00, s10, s01, s11;
    fetch4(srcCoord, mip, srcSize, s00, s10, s01, s11);
    return (s00 + s10 + s01 + s11) * 0.25;
}

void main() {
    ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(dstImage);
    if (dstCoord.x >= dstSize.x || dstCoord.y >= dstSize.y) return;

    ivec2 srcCoord = dstCoord * 2;
    int mip = int(pc.srcMipLevel);
    ivec2 srcSize = ivec2(pc.srcWidth, pc.srcHeight);

    vec4 result;
    if (pc.alphaMode == 1) {
        result = downsampleAlphaWeighted(srcCoord, mip, srcSize);
    } else if (pc.alphaMode == 2) {
        result = downsampleCoveragePreserve(srcCoord, mip, srcSize);
    } else {
        result = downsampleSimple(srcCoord, mip, srcSize);
    }

    if (pc.gammaCorrect == 1) {
        result.rgb = toSRGB(toLinear(result.rgb));
    }

    imageStore(dstImage, dstCoord, result);
}
