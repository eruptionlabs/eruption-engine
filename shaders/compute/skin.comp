#version 450
// Skinning por esqueleto (glTF): cada vértice da pose de bind vira
// soma(peso * matriz do osso) * posição; a normal gira junto. Lê o buffer de
// vértices compartilhado da malha e escreve no buffer próprio da instância
// (o resto do vértice já está lá, copiado uma vez). Posição e normal são
// palavras de 32 bits dentro do vértice (offsets no push constant).
layout(local_size_x = 64) in;

struct SkinVertex { uint j01; uint j23; float w0; float w1; float w2; float w3; };

layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) readonly buffer Skin { SkinVertex skin[]; };
layout(std430, binding = 2) readonly buffer Joints { mat4 joints[]; };
layout(std430, binding = 3) buffer Dst { uint dst[]; };
// Posicao do frame anterior (vetor de movimento): o que estava em Dst.
layout(std430, binding = 4) writeonly buffer Prev { uint prevDst[]; };
// Alvos de morph: por (vertice x alvo) o deslocamento da posicao e da normal;
// os pesos da instancia ficam no mesmo anel dos ossos, lidos como floats.
layout(std430, binding = 5) readonly buffer Morph { vec4 morph[]; };
layout(std430, binding = 6) readonly buffer MorphW { float morphW[]; };

layout(push_constant) uniform Params {
    uint vertexCount;
    uint jointBase;    // primeira matriz desta instância no anel do frame
    uint strideWords;  // tamanho do vértice em palavras
    uint posWord;      // offset da posição (vec3)
    uint nrmWord;      // offset da normal (vec3)
    uint keepPrev;     // 1: copia a posicao atual para Prev antes de escrever
    uint jointCount;   // 0: sem ossos (so' morph)
    uint morphCount;   // alvos de morph (0 = nenhum)
    uint morphBase;    // primeiro peso no anel (em floats)
} p;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p.vertexCount) return;
    const uint b = i * p.strideWords;
    vec3 pos = vec3(uintBitsToFloat(src[b + p.posWord]), uintBitsToFloat(src[b + p.posWord + 1u]),
                    uintBitsToFloat(src[b + p.posWord + 2u]));
    vec3 nrm = vec3(uintBitsToFloat(src[b + p.nrmWord]), uintBitsToFloat(src[b + p.nrmWord + 1u]),
                    uintBitsToFloat(src[b + p.nrmWord + 2u]));
    // Morph antes dos ossos (o deslocamento e' na pose de repouso).
    const uint m0 = i * p.morphCount;
    for (uint t = 0u; t < p.morphCount; ++t) {
        const float w = morphW[p.morphBase + t];
        if (w == 0.0) continue;
        pos += w * morph[(m0 + t) * 2u].xyz;
        nrm += w * morph[(m0 + t) * 2u + 1u].xyz;
    }
    vec3 sp = pos;
    vec3 sn = nrm;
    if (p.jointCount > 0u) {
        const SkinVertex s = skin[i];
        const mat4 m = joints[p.jointBase + (s.j01 & 0xFFFFu)] * s.w0 +
                       joints[p.jointBase + (s.j01 >> 16)] * s.w1 +
                       joints[p.jointBase + (s.j23 & 0xFFFFu)] * s.w2 +
                       joints[p.jointBase + (s.j23 >> 16)] * s.w3;
        sp = (m * vec4(pos, 1.0)).xyz;
        sn = mat3(m) * nrm;
    }
    const float len = length(sn);
    sn = len > 1e-8 ? sn / len : nrm;
    if (p.keepPrev != 0u) {
        prevDst[b + p.posWord] = dst[b + p.posWord];
        prevDst[b + p.posWord + 1u] = dst[b + p.posWord + 1u];
        prevDst[b + p.posWord + 2u] = dst[b + p.posWord + 2u];
    }
    dst[b + p.posWord] = floatBitsToUint(sp.x);
    dst[b + p.posWord + 1u] = floatBitsToUint(sp.y);
    dst[b + p.posWord + 2u] = floatBitsToUint(sp.z);
    dst[b + p.nrmWord] = floatBitsToUint(sn.x);
    dst[b + p.nrmWord + 1u] = floatBitsToUint(sn.y);
    dst[b + p.nrmWord + 2u] = floatBitsToUint(sn.z);
}
