#version 450
// PROBES DE IRRADIANCIA (G38 / P2.4) - bake 2.5D da VISIBILIDADE DO CEU.
//
// Por probe da grade, 64 direcoes (esfera de Fibonacci) marcham contra dois
// heightfields dos MODELOS (topo, visto de cima; base, visto de baixo): o
// ponto esta' dentro de geometria quando fica "abaixo do topo" E "acima da
// base" - a laje entre os dois. Terreno NAO oclui: o ambiente hemisferico ja'
// modela o chao (ambientGround), e contar o chao como oclusao escureceria
// toda parede duas vezes. O terreno so' invalida probes enterradas.
//
// Saida por probe: SH L1 da visibilidade V(w) (L0 + L1.xyz), pesada por
// angulo solido. O ambient.frag avalia E(N) = c4*L0 + 2*c2*(L1.N) e divide
// por pi: ceu aberto da' exatamente 1, embaixo de copa/telhado cai. Probe
// invalida (dentro de geometria) escreve L0 = -1 e e' preenchida pelo
// probe_dilate.comp com a media das vizinhas validas.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0) uniform sampler2D terrainDepth;  // de cima, so' terreno
layout(set = 0, binding = 1) uniform sampler2D modelTopDepth; // de cima, so' modelos
layout(set = 0, binding = 2) uniform sampler2D modelBotDepth; // de baixo, so' modelos
layout(set = 0, binding = 3) uniform BakeUBO {
    mat4 topVP;      // viewProj do render de cima
    mat4 botVP;      // viewProj do render de baixo
    vec4 gridMin;    // xyz = canto minimo da grade
    vec4 cell;       // xyz = tamanho da celula
    uvec4 dims;      // xyz = probes por eixo
    vec4 params;     // x = raio da marcha, y = passos, z = offset inicial
} u;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image3D outProbes;

// "Mais longe do olho do que a superficie gravada": para o render de cima e'
// estar ABAIXO do topo; para o de baixo e' estar ACIMA da base. Fora do mapa
// (uv fora de 0..1) nao ha' geometria.
// `params.w` = ESPESSURA MINIMA da laje em unidades de profundidade do ortho
// (meio passo da marcha): um telhado de mapa legado e' UM poligono, base e topo
// coincidem e a marcha pulava por cima sem nunca "entrar". As copas so'
// funcionavam porque tem espessura real (topo da copa ate' a folha de baixo).
bool beyond(mat4 vp, sampler2D depthTex, vec3 p) {
    vec4 c = vp * vec4(p, 1.0);
    vec2 uv = c.xy * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return false;
    return c.z + u.params.w > texture(depthTex, uv).r;
}
bool insideModels(vec3 p) {
    return beyond(u.topVP, modelTopDepth, p) && beyond(u.botVP, modelBotDepth, p);
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (any(greaterThanEqual(id, u.dims.xyz))) return;
    vec3 p0 = u.gridMin.xyz + (vec3(id) + 0.5) * u.cell.xyz;

    // Probe enterrada no terreno ou dentro de um modelo: invalida.
    if (beyond(u.topVP, terrainDepth, p0) || insideModels(p0)) {
        imageStore(outProbes, ivec3(id), vec4(-1.0, 0.0, 0.0, 0.0));
        return;
    }

    const int   kDirs  = 64;
    const float kGolden = 2.399963; // pi * (3 - sqrt(5))
    const int   steps = int(u.params.y);
    const float radius = u.params.x;
    const float start = u.params.z;
    const float w = 12.566371 / float(kDirs); // 4pi / N
    float L0 = 0.0;
    vec3  L1 = vec3(0.0);
    for (int i = 0; i < kDirs; ++i) {
        // Esfera de Fibonacci: cobertura uniforme sem ruido.
        float y = 1.0 - (float(i) + 0.5) * (2.0 / float(kDirs));
        float r = sqrt(max(0.0, 1.0 - y * y));
        float a = kGolden * float(i);
        vec3 d = vec3(r * cos(a), y, r * sin(a));
        float V = 1.0;
        for (int s = 1; s <= steps; ++s) {
            float t = start + (radius - start) * (float(s) / float(steps));
            if (insideModels(p0 + d * t)) { V = 0.0; break; }
        }
        L0 += V * 0.282095 * w;
        L1 += V * 0.488603 * d * w;
    }
    imageStore(outProbes, ivec3(id), vec4(L0, L1));
}
