#version 450
// PROBES DE IRRADIANCIA (G38 / P2.4) - bake 2.5D da VISIBILIDADE DO CEU.
//
// Por probe da grade, 64 direcoes (esfera de Fibonacci) marcham contra dois
// heightfields dos MODELOS (topo, visto de cima; base, visto de baixo): o
// ponto esta' dentro de geometria quando fica "abaixo do topo" E "acima da
// base" - a laje entre os dois. Terreno NAO oclui: o ambiente hemisferico ja'
// modela o chao (ambientGround), e contar o chao como oclusao escureceria
// toda parede duas vezes. O terreno so' invalida probes enterradas.
//
// Saida por probe: SH L1 da visibilidade V(w) (L0 + L1.xyz), pesada por
// angulo solido. O ambient.frag avalia E(N) = c4*L0 + 2*c2*(L1.N) e divide
// por pi: ceu aberto da' exatamente 1, embaixo de copa/telhado cai. Probe
// invalida (dentro de geometria) escreve L0 = -1 e e' preenchida pelo
// probe_dilate.comp com a media das vizinhas validas.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0) uniform sampler2D terrainDepth;  // de cima, so' terreno
layout(set = 0, binding = 1) uniform sampler2D modelTopDepth; // de cima, so' modelos
layout(set = 0, binding = 2) uniform sampler2D modelBotDepth; // de baixo, so' modelos
layout(set = 0, binding = 3) uniform BakeUBO {
    mat4 topVP;      // viewProj do render de cima
    mat4 botVP;      // viewProj do render de baixo
    vec4 gridMin;    // xyz = canto minimo da grade
    vec4 cell;       // xyz = tamanho da celula
    uvec4 dims;      // xyz = probes por eixo
    vec4 params;     // x = raio da marcha, y = passos, z = offset inicial
} u;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image3D outProbes;

// "Mais longe do olho do que a superficie gravada": para o render de cima e'
// estar ABAIXO do topo; para o de baixo e' estar ACIMA da base. Fora do mapa
// (uv fora de 0..1) nao ha' geometria.
// `params.w` = ESPESSURA MINIMA da laje em unidades de profundidade do ortho
// (meio passo da marcha): um telhado de mapa legado e' UM poligono, base e topo
// coincidem e a marcha pulava por cima sem nunca "entrar". As copas so'
// funcionavam porque tem espessura real (topo da copa ate' a folha de baixo).
bool beyond(mat4 vp, sampler2D depthTex, vec3 p, float eps) {
    vec4 c = vp * vec4(p, 1.0);
    vec2 uv = c.xy * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return false;
    return c.z + eps > texture(depthTex, uv).r;
}
// PISO NO CHAO. Com dois heightfields, "dentro" e' estar entre o topo
// (visto de cima) e a base (vista de baixo). Debaixo de um telhado com piso
// modelado - tapete, assoalho, tablado - a base e' o piso, e a coluna inteira
// do piso ao telhado parecia solida: as probes ali eram anuladas e a dilatacao
// as enchia com as vizinhas de ceu aberto (mundo montado por instancias: 48%
// de probes invalidas e a sombra ambiente das tendas sumindo). Quando a base
// fica a menos de kFloorGap do terreno ela e' um piso, nao o fundo de um
// solido: o que esta' acima dela so' e' "dentro" na casca de kRoofShell
// abaixo do topo. Um solido de verdade no chao (rocha, parede grossa) vira
// casca tambem - por isso a casca tem a espessura de uma parede, e a marcha
// ainda o enxerga.
const float kFloorGap = 12.0;  // u de mundo entre a base e o terreno
const float kRoofShell = 10.0; // u de mundo abaixo do topo
const float kFloorFlat = 2.0;  // u de mundo: variacao maxima da base em volta
// So' piso PLANO: base de moita e copa baixa tambem encosta no terreno, mas e'
// irregular; tratar folhagem como casca escurecia o chao da mata inteira
// (medido no mapa de demonstracao a tarde: 33,5 dB, 15% dos pixels > 8).
bool flatBase(vec2 uv, float d, float kz) {
    vec2 o = vec2(4.0 / 2048.0, 0.0);
    float m = max(max(abs(texture(modelBotDepth, uv + o.xy).r - d), abs(texture(modelBotDepth, uv - o.xy).r - d)),
                  max(abs(texture(modelBotDepth, uv + o.yx).r - d), abs(texture(modelBotDepth, uv - o.yx).r - d)));
    return m / kz < kFloorFlat;
}
bool insideModels(vec3 p, float eps) {
    vec4 ct = u.topVP * vec4(p, 1.0);
    vec2 uvt = ct.xy * 0.5 + 0.5;
    if (any(lessThan(uvt, vec2(0.0))) || any(greaterThan(uvt, vec2(1.0)))) return false;
    float dTop = texture(modelTopDepth, uvt).r;
    if (!(ct.z + eps > dTop)) return false;
    vec4 cb = u.botVP * vec4(p, 1.0);
    vec2 uvb = cb.xy * 0.5 + 0.5;
    if (any(lessThan(uvb, vec2(0.0))) || any(greaterThan(uvb, vec2(1.0)))) return false;
    float dBot = texture(modelBotDepth, uvb).r;
    // Profundidade do ortho por unidade de mundo em Y (linear, igual nos
    // dois renders): converte as diferencas de profundidade em u de mundo.
    float kz = max(abs(u.topVP[1][2]), 1e-9);
    // Altura da base acima do terreno nesta coluna: (yBase - p.y) + (p.y - yTerreno).
    float gap = ((dBot - cb.z) + (ct.z - texture(terrainDepth, uvt).r)) / kz;
    if (gap < kFloorGap && flatBase(uvb, dBot, kz)) return (ct.z - dTop) / kz < kRoofShell + eps / kz;
    return cb.z + eps > dBot;
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (any(greaterThanEqual(id, u.dims.xyz))) return;
    vec3 p0 = u.gridMin.xyz + (vec3(id) + 0.5) * u.cell.xyz;

    // Probe enterrada no terreno ou dentro de um modelo: invalida. Sem a
    // espessura minima: com ela, a probe logo abaixo de um telhado (4 u sob
    // uma laje, com folga de ~7 u) caia "dentro", era anulada e a dilatacao
    // a enchia com as vizinhas de ceu aberto - debaixo da tenda dava vis 1.
    if (beyond(u.topVP, terrainDepth, p0, u.params.w) || insideModels(p0, 0.0)) {
        imageStore(outProbes, ivec3(id), vec4(-1.0, 0.0, 0.0, 0.0));
        return;
    }

    const int   kDirs  = 64;
    const float kGolden = 2.399963; // pi * (3 - sqrt(5))
    const int   steps = int(u.params.y);
    const float radius = u.params.x;
    const float start = u.params.z;
    const float w = 12.566371 / float(kDirs); // 4pi / N
    float L0 = 0.0;
    vec3  L1 = vec3(0.0);
    for (int i = 0; i < kDirs; ++i) {
        // Esfera de Fibonacci: cobertura uniforme sem ruido.
        float y = 1.0 - (float(i) + 0.5) * (2.0 / float(kDirs));
        float r = sqrt(max(0.0, 1.0 - y * y));
        float a = kGolden * float(i);
        vec3 d = vec3(r * cos(a), y, r * sin(a));
        // Passos QUADRATICOS a partir de `start`: densos perto, ralos longe.
        // Os uniformes comecavam em start + passo (~30 u): um telhado a menos
        // disso da probe nunca era amostrado, e debaixo de uma tenda fechada
        // a probe dava vis 0,49. A folga de espessura acompanha o passo
        // local (params.w e' meio passo MEDIO), com piso de metade dela.
        float V = 1.0;
        for (int s = 0; s < steps; ++s) {
            float f = float(s) / float(steps - 1);
            float t = start + (radius - start) * f * f;
            float eps = u.params.w * max(2.0 * f * float(steps) / float(steps - 1), 0.5);
            if (insideModels(p0 + d * t, eps)) { V = 0.0; break; }
        }
        L0 += V * 0.282095 * w;
        L1 += V * 0.488603 * d * w;
    }
    imageStore(outProbes, ivec3(id), vec4(L0, L1));
}
