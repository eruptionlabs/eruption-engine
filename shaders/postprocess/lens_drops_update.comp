#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer LensDrops {
    vec4 drops[]; // xy = pos (0..1), z = radius, w = intensity
} lensDrops;

layout(push_constant) uniform Push {
    vec4 params;  // x=amount, y=storm, z=wind, w=time
    vec4 params2; // x=dt, y=count, z=radiusScale, w=unused
} push;

uint hash(uint x) {
    x += (x << 10u);
    x ^= (x >>  6u);
    x += (x <<  3u);
    x ^= (x >> 11u);
    x += (x << 15u);
    return x;
}

float rand01(uint seed) {
    return float(hash(seed)) / float(0xffffffffu);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint count = uint(push.params2.y + 0.5);
    if (idx >= count) return;

    float amount = push.params.x;
    float storm = push.params.y;
    float wind = push.params.z;
    float dt = push.params2.x;
    float radiusScale = push.params2.z;
    float time = push.params.w;

    vec4 d = lensDrops.drops[idx];
    vec2 pos = d.xy;
    float radius = d.z;
    float intensity = d.w;

    uint seed = idx * 12345u + uint(time * 1000.0);

    // If uninitialized or dead, respawn at top (UV: y=0 top, y=1 bottom)
    if (radius <= 0.0 || pos.y > 1.05 || pos.x < -0.05 || pos.x > 1.05) {
        pos.x = rand01(seed);
        pos.y = -0.1 - rand01(seed + 1u) * 0.1;
        radius = 0.008 + rand01(seed + 2u) * 0.020 * (0.6 + 0.4 * amount);
        radius *= radiusScale;
        intensity = 0.3 + rand01(seed + 3u) * 0.7;
        lensDrops.drops[idx] = vec4(pos, radius, intensity);
        return;
    }

    // Physics: gravity and wind
    float gravity = 0.08 + storm * 0.12 + amount * 0.10;
    float windX = wind * 0.03 * (1.0 + storm);

    // Velocity is implicit: y increases by gravity (descends in UV space), x drifts by wind
    pos.y += gravity * dt;
    pos.x += windX * dt;

    // Slight wobble
    pos.x += (rand01(seed + 4u) - 0.5) * 0.001 * dt;

    lensDrops.drops[idx] = vec4(pos, radius, intensity);
}
