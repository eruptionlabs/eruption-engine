#version 450
#extension GL_GOOGLE_include_directive : require
// NASCIMENTO. Uma thread por particula pedida neste frame (o total vem da
// CPU, que conta os pedidos: dispatch direto, sem leitura de volta). Cada
// thread acha o seu pedido, tira um indice da lista de mortas e entra na
// lista de vivas atual - a simulacao deste mesmo frame ja' a move e desenha.
#define VFX_WRITABLE
#include "vfx/vfx_common.glsl"
#include "vfx/vfx_graph.glsl"
#include "vfx/vfx_spawn.glsl"

layout(local_size_x = 64) in;

void main() {
    uint g = gl_GlobalInvocationID.x;
    uint total = uint(frame.timeInfo.z);
    if (g >= total) return;

    // Pedido desta thread: busca binaria em `first` (pedidos em ordem).
    uint lo = 0u, hi = uint(frame.timeInfo.y);
    while (hi - lo > 1u) {
        uint mid = (lo + hi) >> 1;
        if (spawns[mid].first <= g) lo = mid; else hi = mid;
    }
    SpawnRequest req = spawns[lo];
    uint k = g - req.first;
    Emitter e = emitters[req.slot];

    uint idx;
    if (!vfxPopDead(idx)) return;

    uint seed = pcg(req.seed ^ pcg(k + 0x68E31DA4u));
    float dt = frame.camPos.w;
    // Nascimento interpolado: a k-esima nasce no ponto e no instante certos
    // do caminho do efeito neste frame (rastro continuo mesmo rapido).
    float f = (float(k) + rand01(seed, 1u)) / float(max(req.count, 1u));
    vec3 origin = mix(e.prevPos.xyz, e.posTime.xyz, f);
    Particle p = vfxMakeParticle(e, req.slot, origin, e.velInherit.xyz * e.velInherit.w, seed, (1.0 - f) * dt);
    particles[idx] = p;

    uint cur = frame.counts.x;
    uint slot = atomicAdd(counters[cur], 1u);
    aliveList[cur * frame.counts.y + slot] = idx;
}
