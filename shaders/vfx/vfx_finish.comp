#version 450
#extension GL_GOOGLE_include_directive : require
// Fecha o frame: argumentos do draw indireto (6 vertices por particula).
// firstInstance fica 0 - drawIndirectFirstInstance e' opcional no celular.
#define VFX_WRITABLE
#include "vfx/vfx_common.glsl"

layout(local_size_x = 1) in;

void main() {
    for (uint l = 0u; l < 2u; ++l) {
        uint n = counters[VFXC_RENDER + l];
        // 18 vertices: poligono de 8 lados (corta o canto vazio do quad).
        counters[VFXC_DRAW + l * 4u + 0u] = 18u;
        counters[VFXC_DRAW + l * 4u + 1u] = n;
        counters[VFXC_DRAW + l * 4u + 2u] = 0u;
        counters[VFXC_DRAW + l * 4u + 3u] = 0u;
        counters[VFXC_SORTDISP + l * 4u + 0u] = (n + 63u) / 64u;
        counters[VFXC_SORTDISP + l * 4u + 1u] = 1u;
        counters[VFXC_SORTDISP + l * 4u + 2u] = 1u;
    }
}
