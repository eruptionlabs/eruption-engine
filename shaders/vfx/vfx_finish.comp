#version 450
#extension GL_GOOGLE_include_directive : require
// Fecha o frame: argumentos do draw indireto (6 vertices por particula).
// firstInstance fica 0 - drawIndirectFirstInstance e' opcional no celular.
#define VFX_WRITABLE
#include "vfx/vfx_common.glsl"

layout(local_size_x = 1) in;

void main() {
    // Filhas dos sub-emissores: um workgroup por evento.
    counters[VFXC_EVENTDISP + 0] = min(counters[VFXC_EVENTS], VFX_MAX_EVENTS);
    counters[VFXC_EVENTDISP + 1] = 1u;
    counters[VFXC_EVENTDISP + 2] = 1u;
    for (uint l = 0u; l < 2u; ++l) {
        uint n = counters[VFXC_RENDER + l];
        // Indexado: 18 indices sobre 8 vertices (poligono de 8 lados); o
        // cache de vertices roda o vertex shader 8 vezes, nao 18.
        counters[VFXC_DRAW + l * 5u + 0u] = 18u;
        counters[VFXC_DRAW + l * 5u + 1u] = n;
        counters[VFXC_DRAW + l * 5u + 2u] = 0u;
        counters[VFXC_DRAW + l * 5u + 3u] = 0u;
        counters[VFXC_DRAW + l * 5u + 4u] = 0u;
        counters[VFXC_SORTDISP + l * 4u + 0u] = (n + 63u) / 64u;
        counters[VFXC_SORTDISP + l * 4u + 1u] = 1u;
        counters[VFXC_SORTDISP + l * 4u + 2u] = 1u;
    }
}
