#version 450
#extension GL_GOOGLE_include_directive : require
// SIMULACAO. Uma thread por particula viva (dispatch indireto montado por
// vfx_args). Integra forcas, colide, envelhece; a viva vai para a lista do
// proximo frame e, se estiver no frustum, para a lista de desenho.
//
// Os tres contadores globais (vivas, mortas, desenho) recebem UM atomico por
// workgroup: cada thread soma no contador do grupo (memoria compartilhada) e
// so' a primeira reserva a faixa do grupo no global. Sao 64x menos atomicos
// globais disputando a mesma posicao.
#define VFX_WRITABLE
#include "vfx/vfx_common.glsl"
#include "vfx/vfx_graph.glsl"

layout(local_size_x = 64) in;

shared uint sAlive, sDead, sRender, sLow;
shared uint sAliveBase, sDeadBase, sRenderBase, sLowBase;

// Turbulencia sem divergencia: rotacional de um potencial feito de senos
// (campo analitico; barato e sem textura 3D). Parecido com fumaca/poeira.
vec3 curlNoise(vec3 p, float t) {
    vec3 a = p + vec3(0.0, t, 0.0);
    vec3 b = p * 1.7 + vec3(t * 0.7, 0.0, 3.1);
    // Potencial: Px = sin(a.y)+sin(b.z), Py = sin(a.z)+sin(b.x),
    // Pz = sin(a.x)+sin(b.y); curl = (dPz/dy-dPy/dz, dPx/dz-dPz/dx, dPy/dx-dPx/dy).
    float dPz_dy = 1.7 * cos(b.y);
    float dPy_dz = cos(a.z);
    float dPx_dz = 1.7 * cos(b.z);
    float dPz_dx = cos(a.x);
    float dPy_dx = 1.7 * cos(b.x);
    float dPx_dy = cos(a.y);
    return vec3(dPz_dy - dPy_dz, dPx_dz - dPz_dx, dPy_dx - dPx_dy) * 0.5;
}

void vfxPushEvent(vec3 pos, vec3 vel, uint childSlot, uint count, uint seed) {
    uint i = atomicAdd(counters[VFXC_EVENTS], 1u);
    if (i >= VFX_MAX_EVENTS) return;
    events[i].posSlot = vec4(pos, uintBitsToFloat(childSlot));
    events[i].velSeed = vec4(vel, uintBitsToFloat((count & 0xFFu) | (seed << 8)));
}

vec3 worldFromDepth(vec2 uv, float d) {
    vec4 w = frame.invViewProj * vec4(uv * 2.0 - 1.0, d, 1.0);
    return w.xyz / w.w;
}

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        sAlive = 0u;
        sDead = 0u;
        sRender = 0u;
        sLow = 0u;
    }
    barrier();

    uint cur = frame.counts.x;
    uint cap = frame.counts.y;
    uint i = gl_GlobalInvocationID.x;
    bool valid = i < counters[cur];

    uint idx = 0u;
    bool alive = false;
    bool visible = false;
    bool lowRes = false;
    if (valid) {
        idx = aliveList[cur * cap + i];
        Particle p = particles[idx];
        uint slot = p.slotGen & 0xFFFFu;
        Emitter e = emitters[slot];
        float dt = frame.camPos.w;
        alive = ((e.flags.y & 0xFFFFu) == (p.slotGen >> 16)) && (e.flags.x & VFXF_KILLED) == 0u;
        p.age += dt;
        bool natural = alive && p.age >= p.life; // morreu de velhice (nao por remocao)
        alive = alive && p.age < p.life;
        bool collided = false;
        float impact = 0.0; // velocidade contra a superficie na batida
        uint meshE = (e.flags.x >> VFXF_MESH_SHIFT) & 0xFu;
        if (alive) {
            // Forcas
            // Efeito descrito em metros; a escala da instancia (rot0.w)
            // leva para a unidade do mundo: forcas e turbulencia escalam junto.
            float scale = e.rot0.w;
            vec3 acc = e.gravityDrag.xyz * scale;
            if (e.noise.x != 0.0)
                acc += curlNoise(p.pos * (e.noise.y / scale), frame.timeInfo.x * e.noise.z) * e.noise.x * scale;
            // Grafo: forca extra (m/s2, escalada para o mundo).
            if (e.graphA.w > 0u) acc += vfxRunGraph(e.graphA.z, e.graphA.w, p, e).xyz * scale;
            p.vel += acc * dt;
            p.vel *= 1.0 / (1.0 + e.gravityDrag.w * dt); // arrasto estavel com qualquer dt
            vec3 next = p.pos + p.vel * dt;
            // Malha pousa pela casca, nao pelo centro (sprite: rente).
            float rest = meshE != 0u
                ? unpackHalf2x16(p.sizeRot).x * sampleSizeLut(e, clamp(p.age / p.life, 0.0, 1.0)) * 0.6
                : 0.02;

            // Plano horizontal (chao simples, agua, mesa)
            if ((e.flags.x & VFXF_COLLIDE_PLANE) != 0u && next.y < e.collide.x + rest) {
                next.y = e.collide.x + rest;
                collided = true;
                impact = max(-p.vel.y, 0.0);
                p.vel.y = abs(p.vel.y) * e.noise.w;
                p.vel.xz *= 1.0 - e.collide.y;
                p.age += p.life * e.collide.z;
            }
            // Profundidade da tela: colide com o que a camera ve' (terreno,
            // malhas, personagens). Fora da tela ou atras da superficie mais
            // que a espessura, segue livre - limitacao conhecida da tecnica.
            if ((e.flags.x & VFXF_COLLIDE_DEPTH) != 0u && frame.depthInfo.w > 0.5) {
                // Ponto de contato: a casca no rumo da gravidade (malha), o
                // centro (sprite). Testar o centro deixava a pedra cair a
                // casca inteira antes de bater - pulava parada no chao.
                vec3 g = e.gravityDrag.xyz;
                vec3 probe = next + (dot(g, g) > 1e-8 ? normalize(g) : vec3(0.0, -1.0, 0.0)) * (rest - 0.02);
                vec4 c = frame.viewProj * vec4(probe, 1.0);
                if (c.w > 0.0) {
                    vec3 ndc = c.xyz / c.w;
                    vec2 uv = ndc.xy * 0.5 + 0.5;
                    if (all(greaterThan(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)))) {
                        float d = textureLod(sceneDepth, uv, 0.0).r;
                        if (d < 1.0 && ndc.z > d) {
                            vec3 surf = worldFromDepth(uv, d);
                            float thickness = max(0.5 * e.rot0.w, length(p.vel) * dt * 2.0);
                            if (distance(surf, probe) < thickness) {
                                vec2 px = 1.0 / frame.depthInfo.xy;
                                vec3 sx = worldFromDepth(uv + vec2(px.x, 0.0), textureLod(sceneDepth, uv + vec2(px.x, 0.0), 0.0).r);
                                vec3 sy = worldFromDepth(uv + vec2(0.0, px.y), textureLod(sceneDepth, uv + vec2(0.0, px.y), 0.0).r);
                                vec3 n = normalize(cross(sx - surf, sy - surf));
                                if (dot(n, frame.camPos.xyz - surf) < 0.0) n = -n;
                                float vn = dot(p.vel, n);
                                impact = max(impact, -vn);
                                if (vn < 0.0) {
                                    vec3 vt = p.vel - vn * n;
                                    p.vel = vt * (1.0 - e.collide.y) - vn * n * e.noise.w;
                                }
                                next = surf + n * rest;
                                collided = true;
                                p.age += p.life * e.collide.z;
                            }
                        }
                    }
                }
            }
            p.pos = next;
            if (meshE != 0u) {
                // Giro acumulado (nao idade x velocidade): a batida rouba giro
                // e a pedra parada no chao para de rodar.
                vec2 sr0 = unpackHalf2x16(p.sizeRot);
                vec2 av0 = unpackHalf2x16(p.angVel);
                if (collided) av0.x *= 0.55;
                sr0.y = mod(sr0.y + av0.x * dt, 6.2831853);
                p.sizeRot = packHalf2x16(sr0);
                p.angVel = packHalf2x16(av0);
            }
            natural = natural || (p.age >= p.life);
            alive = p.age < p.life;
            particles[idx] = p;
            // Sub-emissor na batida: so' impacto de verdade (a particula
            // parada no chao "bate" todo frame e virava chuva de eventos).
            float minImpact = max(length(e.gravityDrag.xyz) * e.rot0.w * dt * 3.0, 0.8 * e.rot0.w);
            if (collided && impact > minImpact && e.events.y != 0u) {
                float prob = float((e.events.w >> 8) & 0xFFu) / 255.0;
                uint s = pcg(p.seed ^ floatBitsToUint(p.age));
                if (rand01(s, 31u) < prob)
                    vfxPushEvent(p.pos, p.vel * (float(e.events.z >> 24) / 255.0), e.events.y - 1u,
                                 (e.events.z >> 8) & 0xFFu, s);
            }
        }
        // Sub-emissor na morte (de velhice).
        if (natural && e.events.x != 0u) {
            float prob = float(e.events.w & 0xFFu) / 255.0;
            uint s = pcg(p.seed ^ 0x51ED270Bu);
            if (rand01(s, 37u) < prob)
                vfxPushEvent(p.pos, p.vel * (float((e.events.z >> 16) & 0xFFu) / 255.0), e.events.x - 1u,
                             e.events.z & 0xFFu, s);
        }
        if (alive) {
            // Aparencia nesta idade, calculada UMA vez (o desenho so' le').
            float t = clamp(p.age / p.life, 0.0, 1.0);
            vec2 sr = unpackHalf2x16(p.sizeRot);
            vec2 av = unpackHalf2x16(p.angVel);
            float size = sr.x * sampleSizeLut(e, t);
            if (e.graphB.w > 0u) size *= max(vfxRunGraph(e.graphB.z, e.graphB.w, p, e).x, 0.0);
            float viewZ = (frame.viewProj * vec4(p.pos, 1.0)).w;
            // Teto de tamanho na tela: a particula que encosta na camera nao
            // vira uma parede de overdraw (o custo de fumaca e' de fill-rate).
            size = min(size, e.render.z * max(viewZ, 1e-3) / max(frame.viewInfo.x, 1e-3));
            float stretchLen = e.angVel.z * length(p.vel);
            float radius = size + stretchLen * 0.5 + 0.01;
            bool ribbon = e.ribbon.y > 0u;
            visible = true;
            // Ponto de fita nao e' cortado: o vizinho le' o registro dele.
            for (int k = 0; k < 6 && visible && !ribbon; ++k)
                visible = dot(frame.frustum[k].xyz, p.pos) + frame.frustum[k].w > -radius;
            lowRes = (e.flags.x & VFXF_LOWRES) != 0u;
            uint meshId = (e.flags.x >> VFXF_MESH_SHIFT) & 0xFu;
            if (visible && meshId != 0u) {
                // MALHA: opaca no G-buffer (luz da cena de verdade). Registro
                // com cor-base (albedo), eixo/angulo do giro, deslocamento do
                // frame (velocidade no G-buffer) e brilho proprio.
                vec4 col = unpackColorLut(e, t);
                if (e.graphB.y > 0u) col *= max(vfxRunGraph(e.graphB.x, e.graphB.y, p, e), vec4(0.0));
                vec3 axis = normalize(vec3(rand01(p.seed, 41u), rand01(p.seed, 42u), rand01(p.seed, 43u)) - 0.5 + 1e-4);
                vec3 disp = p.vel * dt;
                RenderRec rec;
                rec.posSize = vec4(p.pos, size);
                rec.look = uvec4(packHalf2x16(col.rg), packHalf2x16(col.ba), packHalf2x16(vec2(sr.y, 0.0)), packOct(axis));
                rec.sheet = uvec4(e.flags.z, packHalf2x16(vec2(disp.z, e.render.x)), packHalf2x16(disp.xy), p.seed);
                rec.cutout = uvec4(0u);
                recs[idx] = rec;
                // LOD: pequena na tela (raio < 24 px) usa a versao de longe
                // (80 triangulos ainda fecham a silhueta), que nao faz sombra.
                uint lo = (e.flags.x >> VFXF_MESHLO_SHIFT) & 0xFu;
                float rpx = size * frame.viewInfo.x / max(viewZ, 1e-3) * frame.depthInfo.y * 0.5;
                if (lo != 0u && rpx < 24.0) meshId = lo;
                uint m = meshId - 1u;
                uint per = cap / VFX_MESH_TYPES;
                uint ms = atomicAdd(counters[VFXC_MESH + m], 1u);
                if (ms < per) renderList[4u * cap + m * per + ms] = idx;
                visible = false; // nao entra nas listas de sprite
            }
            if (visible) {
                vec4 col = unpackColorLut(e, t);
                col.rgb *= e.render.x;
                if (e.graphB.y > 0u) col *= max(vfxRunGraph(e.graphB.x, e.graphB.y, p, e), vec4(0.0));
                vec3 toCam = normalize(frame.camPos.xyz - p.pos + vec3(0.0, 1e-5, 0.0));
                if (e.render.y > 0.0) {
                    // Normal falsa entre "para a camera" e "para cima": a nuvem de
                    // particulas recebe sol por cima, como fumaca de verdade.
                    vec3 L = -normalize(frame.sunDir.xyz);
                    vec3 n = normalize(toCam + vec3(0.0, 1.0, 0.0));
                    float wrap = clamp(dot(n, L) * 0.5 + 0.5, 0.0, 1.0);
                    vec3 light = frame.ambient.rgb * frame.ambient.w + frame.sunColor.rgb * frame.sunDir.w * wrap;
                    col.rgb *= mix(vec3(1.0), light, e.render.y);
                }
                // Some perto da camera em vez de cobrir a tela.
                col.a *= smoothstep(frame.timeInfo.w, frame.timeInfo.w + max(e.render.w * e.rot0.w, 1e-3), viewZ);
                // Folha de quadros: ao longo da vida, em quadros/s ou sorteado fixo.
                uint cols = max(e.flags.w & 0xFFu, 1u);
                uint rows = max((e.flags.w >> 8) & 0xFFu, 1u);
                float frames = float(cols * rows);
                float fpos = e.flip.z > 1.5 ? floor(av.y * frames)
                           : (e.flip.z > 0.5 ? p.age * e.flip.x : t * (frames - 0.001)) + av.y * frames;
                float f0 = mod(floor(fpos), frames);
                float fmix = ((e.flags.x & VFXF_FLIP_BLEND) != 0u && e.flip.z < 1.5) ? fract(fpos) : 0.0;
                vec3 axis = dot(p.vel, p.vel) > 1e-10 ? normalize(p.vel) : vec3(0.0, 1.0, 0.0);
                RenderRec rec;
                rec.posSize = vec4(p.pos, size);
                rec.look = uvec4(packHalf2x16(col.rg), packHalf2x16(col.ba),
                                 packHalf2x16(vec2(sr.y + av.x * p.age, stretchLen)), packOct(axis));
                uint facing = (e.flags.x >> VFXF_FACING_SHIFT) & 3u;
                uint blend = (e.flags.x >> VFXF_BLEND_SHIFT) & 3u;
                rec.sheet = uvec4(e.flags.z, cols | (rows << 8) | (blend << 16) | (facing << 18),
                                  uint(f0) | (uint(fmix * 255.0 + 0.5) << 16), floatBitsToUint(e.angVel.w * e.rot0.w));
                rec.cutout = e.cutout;
                if (ribbon) {
                    // Vizinho na fita: o ponto que nasceu logo depois (seq + 1),
                    // se ainda for desta fita e estiver vivo.
                    uint seq = p.angVel;
                    uint n = ribbonRing[e.ribbon.x + (seq + 1u) % e.ribbon.y];
                    Particle q = particles[n];
                    bool ok = q.slotGen == p.slotGen && q.angVel == seq + 1u && q.age < q.life && n != idx;
                    rec.look.w = ok ? n + 1u : 0u;
                    rec.sheet.y = 1u | (1u << 8) | (blend << 16) | (3u << 18);
                    rec.sheet.z = packHalf2x16(vec2(t, 0.0));
                }
                recs[idx] = rec;
            }
        }
    }

    // Reserva por grupo
    uint aliveSlot = 0u, deadSlot = 0u, renderSlot = 0u;
    if (valid) {
        if (alive) aliveSlot = atomicAdd(sAlive, 1u);
        else deadSlot = atomicAdd(sDead, 1u);
        if (visible) renderSlot = lowRes ? atomicAdd(sLow, 1u) : atomicAdd(sRender, 1u);
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        sAliveBase = sAlive > 0u ? atomicAdd(counters[1u - cur], sAlive) : 0u;
        sDeadBase = sDead > 0u ? atomicAdd(counters[VFXC_DEAD], sDead) : 0u;
        sRenderBase = sRender > 0u ? atomicAdd(counters[VFXC_RENDER], sRender) : 0u;
        sLowBase = sLow > 0u ? atomicAdd(counters[VFXC_RENDER + 1], sLow) : 0u;
    }
    barrier();
    if (valid) {
        if (alive) aliveList[(1u - cur) * cap + sAliveBase + aliveSlot] = idx;
        else deadList[sDeadBase + deadSlot] = idx;
        if (visible) {
            if (lowRes) renderList[cap + sLowBase + renderSlot] = idx;
            else renderList[sRenderBase + renderSlot] = idx;
        }
    }
}
